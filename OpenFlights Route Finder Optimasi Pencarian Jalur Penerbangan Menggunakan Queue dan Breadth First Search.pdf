/E ( def check_connectivity\(self, start, end\): path = self.find_shortest_path\(start, end\) is_connected = path is not None # Hitung bandara terjangkau dari start reachable_count = 0 visited = set\(\) queue.enqueue\(start\) while not queue.is_empty\(\): node = queue.dequeue\(\) reachable_count += 1 for neighbor in graph.get\(node\): if neighbor not in visited: visited.add\(neighbor\) queue.enqueue\(neighbor\) return is_connected, path, transits, reachable_count )
/Pg 16 0 R
/K [5]
>>
