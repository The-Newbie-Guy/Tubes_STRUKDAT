/E ( def analyze_reachability_by_level\(self, start, max_levels=5\): levels = {i: [] for i in range\(max_levels + 1\)} visited = set\(\) queue.enqueue\(\(start, 0\)\) # \(node, level\) while not queue.is_empty\(\): current_node, current_level = queue.dequeue\(\) next_level = current_level + 1 for neighbor in graph.get\(current_node\): if neighbor not in visited: levels[next_level].append\(neighbor\) queue.enqueue\(\(neighbor, next_level\)\) )
/Pg 16 0 R
/K [1]
>>
endobj
